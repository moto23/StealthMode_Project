# ---- Server ----
PORT=5000

# ---- Database ----
# MongoDB Atlas connection string (rotate any previously exposed credential)
MONGODB_URI=your_mongodb_connection_string

# ---- Auth / JWT ----
# Use a long random string in production
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

# ---- Email (Resend) ----
# Server-side only. Never expose to the frontend.
RESEND_API_KEY=your_resend_api_key
# Verified sender. "onboarding@resend.dev" works for testing (delivers only to the Resend account owner).
RESEND_FROM_EMAIL=StealthMode <onboarding@resend.dev>

# ---- OTP ----
OTP_EXPIRY_MINUTES=10

# ---- Razorpay (TEST MODE) ----
# Server-side only. Never expose the secret to the frontend.
# Use test credentials (rzp_test_...) — no real-money transactions.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# ---- Frontend ----
# Used for CORS allow-list and password-reset links
FRONTEND_URL=https://stealthmode-frontend.vercel.app

# ---- Mux signed video playback (Phase 7, Slice 4) ----
# Server-side ONLY. Never expose to the frontend / never place under frontend/src.
# These are a Mux "Signing Key" (Settings -> Signing Keys in the Mux Dashboard),
# NOT the API access token. Used to mint short-lived RS256 JWTs so the browser
# can stream signed-playback lessons without ever seeing the private key.
#   MUX_SIGNING_KEY_ID          — the signing key id (becomes the JWT `kid`)
#   MUX_SIGNING_KEY_PRIVATE_KEY — that key's RSA private key, base64-encoded
#                                 (exactly as the Mux Dashboard provides it)
MUX_SIGNING_KEY_ID=your_mux_signing_key_id
MUX_SIGNING_KEY_PRIVATE_KEY=your_mux_signing_key_private_key_base64
# Optional: MINIMUM playback token lifetime in seconds (default 3600 = 1 hour).
# This is a floor — for a lesson whose duration is known, the server extends the
# token to cover the whole video plus a 30-minute cushion (Mux requires the
# token to outlive playback). The client also refreshes before expiry.
# MUX_TOKEN_EXPIRY_SECONDS=3600
# Optional: Mux API access token — only needed for creating/uploading assets
# via the Mux API (asset management), NOT for issuing playback tokens.
# MUX_TOKEN_ID=your_mux_api_token_id
# MUX_TOKEN_SECRET=your_mux_api_token_secret
